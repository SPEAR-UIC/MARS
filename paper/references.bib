@inproceedings{zhou_improving_2015,
	title = {Improving {Batch} {Scheduling} on {Blue} {Gene}/{Q} by {Relaxing} {5D} {Torus} {Network} {Allocation} {Constraints}},
	url = {https://ieeexplore.ieee.org/document/7161532},
	doi = {10.1109/IPDPS.2015.110},
	abstract = {As systems scale toward exactable, many resources will become increasingly constrained. While some of these resources have historically been explicitly allocated, many – such as network bandwidth, I/O bandwidth, or power – have not. As systems continue to evolve, we expect many such resources to become explicitly managed. This change will pose critical challenges to resource management and job scheduling. In this paper, we explore the potentiality of relaxing network allocation constraints for Blue Gene systems. Our objectives to improve the batch scheduling performance, where the partition-based interconnect architecture provides a unique opportunity to explicitly allocate network resources to jobs. This paper makes three major contributions. The first is substantial benchmarking of parallel applications, focusing on assessing application sensitivity to communication bandwidth at large scale. The second is two new scheduling schemes using relaxed network allocation and targeted at balancing individual job performance with overall system performance. The third is a comparative study of our scheduling schemes versus the existing one under different workloads, using job traces collected from the 48-rack Mira, an IBM Blue Gene/Q system at Argonne National Laboratory.},
	urldate = {2025-07-14},
	booktitle = {2015 {IEEE} {International} {Parallel} and {Distributed} {Processing} {Symposium}},
	author = {Zhou, Zhou and Yang, Xu and Lan, Zhiling and Rich, Paul and Tang, Wei and Morozov, Vitali and Desai, Narayan},
	month = may,
	year = {2015},
	note = {ISSN: 1530-2075},
	keywords = {Bandwidth, Benchmark testing, Network topology, Resource management, Runtime, Scheduling, Wiring},
	pages = {439--448},
	file = {Full Text PDF:/Users/yash/Zotero/storage/NC86FLEA/Zhou et al. - 2015 - Improving Batch Scheduling on Blue GeneQ by Relaxing 5D Torus Network Allocation Constraints.pdf:application/pdf},
}

@inproceedings{zheng_exploring_2016,
	title = {Exploring {Plan}-{Based} {Scheduling} for {Large}-{Scale} {Computing} {Systems}},
	url = {https://ieeexplore.ieee.org/document/7776518/},
	doi = {10.1109/CLUSTER.2016.43},
	abstract = {As HPC systems scale toward exascale, it becomes critical to manage the underlying resource more effectively. While almost all existing resource management systems schedule jobs in a queuing fashion and have drawbacks of making isolated scheduling decisions that would compromise system performance even with backfilling, plan-based schedulers have the potential to generate better job schedules by producing an execution plan of all waiting jobs but do not receive enough attention. In this paper, we present a novel plan-based scheduling system that utilizes simulated annealing as the optimization engine to support effective resource management on HPC systems. As demonstrated by extensive trace-based simulations with workload traces collected from a wide range of production supercomputers, in comparison with the queue-based scheduling system using FCFS with EASY backfilling, our plan-based scheduling system can reduce the job wait time by 40\%, reduce the job response time by 30\%, while slightly improving system utilization at the same time. Moreover, our plan-based system is able to run online by solving the scheduling problem at each scheduling iteration within one second, making it practical for production HPC systems.},
	urldate = {2025-07-16},
	booktitle = {2016 {IEEE} {International} {Conference} on {Cluster} {Computing} ({CLUSTER})},
	author = {Zheng, Xingwu and Zhou, Zhou and Yang, Xu and Lan, Zhiling and Wang, Jia},
	month = sep,
	year = {2016},
	note = {ISSN: 2168-9253},
	keywords = {Job shop scheduling, Optimization, Plan-based scheduling, Processor scheduling, Resource management, Schedules, Simulated Annealing algorithm, System performance},
	pages = {259--268},
	file = {Full Text PDF:/Users/yash/Zotero/storage/MZP5KSVT/Zheng et al. - 2016 - Exploring Plan-Based Scheduling for Large-Scale Computing Systems.pdf:application/pdf},
}

